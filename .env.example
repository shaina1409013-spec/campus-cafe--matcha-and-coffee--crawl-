# MySQL connection (local development)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=coffee_crawl
MYSQL_SSL=false

# JWT – use a long random string (min 32 chars)
JWT_SECRET=replace_this_with_a_long_random_secret_string_at_least_32_chars

# Optional: frontend origin for stricter CORS (not required for static sites)
# FRONTEND_URL=https://your-vercel-domain.vercel.app
